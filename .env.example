# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Impact Score Dashboard
#
# Copy to `.env` and fill in real values. `.env` is gitignored.
# Variables here are consumed by docker-compose and by the PHP application.
#
# How to generate strong values:
#   Passwords / DB creds:     openssl rand -base64 32
#   Single-use tokens:        openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
# When APP_ENV=production, the app refuses to start if any secret below still
# matches a placeholder (changeme / change-this-secret-token).
APP_ENV=production
APP_DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# DB_HOST is the in-network service name when running under docker-compose.
# For non-Docker installs, set to your MySQL hostname.
DB_HOST=db
DB_NAME=impact_score
DB_USER=impact_user
DB_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme_root

# ── Admin bootstrap ───────────────────────────────────────────────────────────
# Single-use token printed by `make setup`. Rotate immediately after the
# first admin login completes.
BOOTSTRAP_ADMIN_TOKEN=change-this-secret-token

# ── Session security ──────────────────────────────────────────────────────────
# Set to true when running behind HTTPS so PHP marks session cookies as Secure.
# Leaving false behind HTTPS leaks the session cookie over plaintext fallback.
SESSION_SECURE_ONLY=false

# ── Outlook / O365 SMTP (optional) ────────────────────────────────────────────
# Used by compare_report.php email-out features. Leave blank to disable.
OUTLOOK_HOST=smtp.office365.com
OUTLOOK_PORT=587
OUTLOOK_USERNAME=
OUTLOOK_PASSWORD=
OUTLOOK_FROM_ADDRESS=
OUTLOOK_FROM_NAME=

# ── Backups (optional) ────────────────────────────────────────────────────────
# Local retention in days. Used by scripts/backup.sh.
BACKUP_RETENTION_DAYS=30

# Off-host destination for backups. Leave blank for local-only.
# Recognized prefixes:
#   s3://bucket/path     → routed via `aws s3 cp` (requires AWS CLI + creds)
#   rsync://host/path or
#   user@host:/path      → routed via `rsync`
BACKUP_REMOTE=

# ─────────────────────────────────────────────────────────────────────────────
# Production-deployment reminders
#
# 1. Behind HTTPS, set SESSION_SECURE_ONLY=true and confirm any OAuth redirect
#    URIs registered with your IdP use https:// and match exactly.
# 2. BOOTSTRAP_ADMIN_TOKEN is single-use — rotate after first admin login.
# 3. Never commit a populated .env. `.gitignore` enforces this; double-check
#    `git status` before any push.
# 4. After rotating DB credentials, restart the stack: `make restart`.
# ─────────────────────────────────────────────────────────────────────────────
